{
  "name": "kms111-rebuild-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Server + protocol tooling for the MapleStory KMS 1.11 (2003) rebuild. Zero runtime dependencies.",
  "engines": {
    "node": ">=26.12.0 <27",
    "npm": ">=12.2.0 <13"
  },
  "scripts": {
    "capture": "node src/cli.ts capture",
    "test": "node --test \"**/*.test.ts\"",
    "check": "node --test \"**/*.test.ts\" && tsc -p .",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.2.0"
}
