{
  "name": "kms-1-11",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "serve": "bun server/src/cli.ts serve",
    "capture": "bun server/src/cli.ts capture",
    "test": "bun test --timeout 30000 ./server/test ./tools/tests",
    "typecheck": "bun run --bun tsc --project tsconfig.json",
    "format": "bun run --bun prettier --write \"client/**/*.ts\" \"server/**/*.ts\" \"tools/**/*.ts\" package.json tsconfig.json .prettierrc.json .github/workflows/ci.yml",
    "format:check": "bun run --bun prettier --check \"client/**/*.ts\" \"server/**/*.ts\" \"tools/**/*.ts\" package.json tsconfig.json .prettierrc.json .github/workflows/ci.yml",
    "build": "bun tools/build-client.ts",
    "check": "bun run typecheck && bun run format:check && bun run test && bun run build",
    "wz": "bun tools/wz.ts",
    "setup": "bun tools/setup.ts"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/bun": "1.4.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
